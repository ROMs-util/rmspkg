{
    "_comment": "roms_package.json — installer config template. Fill in values for your project.",

    "name": "your-project-name",
    "version": "1.0.0",
    "description": "short description of what this script does",
    "commandName": "your-command-name",
    "installDir": "C:\\roms\\your-app",
    "files": [
        "main.ps1",
        "run.bat",
        "rms_install.ps1"
    ],

    "dependencies": {
        "system": {
            "os": "Windows 10 / 11",
            "powershell": "5.1",
            "privileges": "Administrator"
        }
    },

    "_hooks_info": "If 'rms_install.ps1' is included in the 'files' list, it will be executed automatically after all files are copied."
}
